{
  "name": "grim-dawn-trainer",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Minimal session-only Grim Dawn trainer with one-time character actions",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "desktop": "node scripts/tauri.mjs dev",
    "package": "node scripts/tauri.mjs build",
    "check": "tsc --noEmit",
    "test:core": "node scripts/cargo.mjs test -p grim-core --all-features",
    "format:check": "prettier --check src scripts package.json tsconfig.json vite.config.ts",
    "build:runtime": "python3 scripts/build-runtime.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
